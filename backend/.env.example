# ── GitLab ────────────────────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.com
# Personal access token — scopes: api + write_repository
GITLAB_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token or GitHub App installation token
# Scopes: repo (full control of private repos)
GITHUB_TOKEN=

# ── Bitbucket ─────────────────────────────────────────────────────────────────
# App Password — permissions: Repositories (Read + Write), Branch restrictions (Read + Write)
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ── AWS CodeCommit ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file in the backend directory (fine for local dev)
# For production swap to PostgreSQL: postgresql://user:password@host:5432/portal
DATABASE_URL=sqlite:///./portal.db

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins (default: * for local dev)
CORS_ORIGINS=http://localhost:3005,http://localhost:4000
